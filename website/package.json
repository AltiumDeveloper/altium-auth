{
  "name": "altium-auth-docs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Documentation site for the Altium 365 authentication libraries and specification.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run search:index && docusaurus start",
    "build": "npm run search:index && docusaurus build && npm run search:check && npm run llms && npm run llms:check",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "search:index": "node scripts/search-index.mjs",
    "search:check": "node scripts/search-check.mjs",
    "llms": "node scripts/llms.mjs",
    "llms:check": "node scripts/llms-check.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@giscus/react": "^3.1.0",
    "@mdx-js/react": "^3.1.1",
    "github-slugger": "^1.5.0",
    "minisearch": "^7.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "typescript": "~5.6.2"
  }
}
